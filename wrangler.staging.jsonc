{
  // Entorno de preproducción (frente 4 del plan de fiabilidad). Recursos
  // completamente separados de wrangler.deploy.jsonc: ningún despliegue ni
  // ejecución contra este archivo toca la D1, el bucket R2 ni el Worker de
  // producción. La base arranca vacía a propósito (ver
  // .github/workflows/staging-provisionar.yml).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "araya-centro-control-staging",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/data-center/*"]
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "araya-centro-control-d1-staging",
      "database_id": "de118df4-0220-427c-8f11-8ceda0eb675a",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "araya-centro-control-staging-files"
    }
  ]
}
